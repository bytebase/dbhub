{
  "mcpServers": {
    "dbhub": {
      "command": "npx",
      "args": [
        "-y",
        "@bytebase/dbhub@2.0.2",
        "--transport",
        "stdio",
        "--config",
        "./dbhub.toml"
      ],
      "cwd": ".",
      "env_vars": [
        "DBHUB_DSN"
      ],
      "startup_timeout_sec": 120
    }
  }
}
