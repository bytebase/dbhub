{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "fonts": {
    "family": "DM Sans"
  },
  "name": "DBHub, Minimal Database MCP Server",
  "colors": {
    "primary": "#323236",
    "light": "#FFFFFF",
    "dark": "#323236"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "groups": [
      {
        "group": "Getting Started",
        "pages": [
          "introduction",
          {
            "group": "Installation",
            "root": "installation",
            "expanded": true,
            "pages": ["mcpb", "claude-code-plugin", "codex-plugin"]
          },
          "quickstart"
        ]
      },
      {
        "group": "MCP Tools",
        "pages": [
          "tools/overview",
          "tools/execute-sql",
          "tools/search-objects",
          "tools/explain-sql",
          "tools/health-check",
          "tools/custom-tools"
        ]
      },
      {
        "group": "Workbench",
        "pages": ["workbench/overview", "workbench/tool-execution", "workbench/request-trace"]
      },
      {
        "group": "Configuration",
        "pages": ["config/command-line", "config/toml", "config/read-only-mode", "config/debug"]
      },
      {
        "group": "Blog",
        "pages": [
          "blog/modelcontextprotocol-server-postgres-alternative",
          "blog/database-mcp-server-token-benchmark-2026",
          "blog/dbhub-1-0-0",
          "blog/how-dbhub-adopts-mcp-spec-2026-07-28",
          "blog/state-of-postgres-mcp-servers-2025",
          "blog/postgres-mcp-server-review-dbhub",
          "blog/postgres-mcp-server-review-supabase-mcp",
          "blog/postgres-mcp-server-review-mcp-toolbox"
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/logo/full-light.svg",
    "dark": "/images/logo/full-dark.svg",
    "href": "/"
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/bytebase/dbhub"
    },
    "links": [
      {
        "label": "Docs",
        "href": "/introduction"
      },
      {
        "label": "Blog",
        "href": "/blog/modelcontextprotocol-server-postgres-alternative"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/bytebase/dbhub",
      "x": "https://x.com/Bytebase"
    }
  },
  "contextual": {
    "options": ["copy", "view"]
  },
  "errors": {
    "404": {
      "redirect": false
    }
  },
  "seo": {
    "metatags": {
      "canonical": "https://dbhub.ai"
    }
  },
  "integrations": {
    "plausible": {
      "domain": "dbhub.ai"
    }
  }
}
